# ==============================================================================
# Jarvis KPI Bot — Exemplo de Configuração (.env)
# Copie este arquivo para `.env` e preencha suas credenciais reais.
# NUNCA versione o arquivo `.env`.
# ==============================================================================

# Credenciais obrigatórias para execução do Bot no Telegram
TELEGRAM_TOKEN=seu_token_do_botfather_aqui
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui

# Modelo OpenAI e timeout de rede (segundos)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# Estratégia Híbrida de Banco de Dados:
# - Vazio ou sqlite:///... -> usa SQLite local somente leitura (sandbox_jarvis.db)
# - postgresql://... -> usa PostgreSQL (use o usuário somente leitura nas consultas do bot/MCP)
DATABASE_URL=
DATABASE_ADMIN_URL=postgresql://jarvis_admin:troque_esta_senha@localhost:5432/corporativo_db

# Credenciais do container Docker PostgreSQL (usadas pelo docker-compose.yml)
POSTGRES_DB=corporativo_db
POSTGRES_ADMIN_USER=jarvis_admin
POSTGRES_ADMIN_PASSWORD=troque_esta_senha
POSTGRES_READONLY_USER=jarvis_readonly
POSTGRES_READONLY_PASSWORD=troque_esta_senha_ro

# Integração MCP: true executa consultas via Servidor MCP; false usa repositório em processo
USE_MCP=true

# Controle de Acesso e Rate Limit no Telegram:
# IDs numéricos separados por vírgula (ex: 123456789,987654321).
# Se vazio, opera em modo dev/homologação emitindo WARNING no log de inicialização.
TELEGRAM_ALLOWED_USER_IDS=
RATE_LIMIT_PER_MINUTE=12

# Memória conversacional curta por chat_id
CHAT_HISTORY_MAX_TURNS=5
CHAT_HISTORY_TTL_SECONDS=1800
